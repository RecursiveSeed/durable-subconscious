{
  "name": "durable-subconscious",
  "version": "0.6.0",
  "description": "Local, persistent architectural memory, conceptual retrieval, and dependency-impact analysis for AI coding agents",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "durable-subconscious": "bin/durable-subconscious.mjs"
  },
  "durableSubconscious": {
    "stateSchema": 1,
    "graphSchema": 1,
    "freshnessSchema": 1,
    "supportedUpgradeFrom": [
      "0.3.x",
      "0.4.x",
      "0.5.x",
      "0.6.x"
    ]
  },
  "files": [
    "bin",
    "docs",
    "examples",
    "src",
    "CONTRIBUTING.md",
    "INSTALL.md",
    "LICENSE",
    "README.md",
    "RELEASE_NOTES.md",
    "SECURITY.md"
  ],
  "scripts": {
    "check:example": "node bin/durable-subconscious.mjs check --project examples/synthetic-project --config subconscious/config.json",
    "discover:example": "node bin/durable-subconscious.mjs discover --project examples/synthetic-project --config subconscious/config.json",
    "test": "node --test test/core.test.mjs test/v050.test.mjs test/final-consumer-contracts.test.mjs examples/synthetic-project/test/catalog.test.mjs examples/final-consumer-contracts/test/producer.test.mjs examples/final-consumer-contracts/test/control-panel.test.mjs examples/final-consumer-contracts/test/archive-feed.test.mjs"
  }
}
